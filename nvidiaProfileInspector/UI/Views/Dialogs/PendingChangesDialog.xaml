<Window
    x:Class="nvidiaProfileInspector.UI.Views.Dialogs.PendingChangesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pending Changes"
    Width="640"
    MinWidth="520"
    MinHeight="320"
    MaxHeight="620"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource DarkDialogWindowStyle}"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,12,0,0"
            Background="Transparent">
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="Pending Changes" />
                    <Border
                        Margin="12,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource NvidiaGreenBrush}"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding PendingChangesCount}" />
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,-12,0,0"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button
                        Click="Close_Click"
                        Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="Close">
                        <Path
                            Width="10"
                            Height="10"
                            Data="{StaticResource IconClose}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox
            x:Name="ChangesList"
            Grid.Row="1"
            Margin="24,12,24,12"
            MaxHeight="380"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding ModifiedSettingsSnapshot}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Padding="12,8"
                        Background="{DynamicResource Layer1BackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Text="{Binding SelectedValue}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Click="ResetRow_Click"
                                Content="Revert"
                                Style="{StaticResource DarkButtonStyle}"
                                ToolTip="Discard this change" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border
            Grid.Row="2"
            Padding="24,16"
            Background="{DynamicResource Layer2BackgroundBrush}"
            CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Click="DiscardAll_Click"
                    Content="Discard all"
                    Style="{StaticResource DarkButtonStyle}"
                    ToolTip="Discard all unsaved changes" />
                <Button
                    MinWidth="100"
                    Margin="0,0,8,0"
                    Click="Apply_Click"
                    Content="Apply"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTip="Apply all changes to the driver" />
                <Button
                    MinWidth="100"
                    Click="Close_Click"
                    Content="Close"
                    IsCancel="True"
                    Style="{StaticResource DarkButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
